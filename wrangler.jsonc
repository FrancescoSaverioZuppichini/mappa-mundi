// [Agent] An assets-only Worker: no server code, Cloudflare serves dist/ as static files and applies public/_headers. State lives in the URL hash, so there is no SPA fallback to configure.
{
  "name": "mappa-mundi",
  "compatibility_date": "2026-09-30",
  "assets": { "directory": "./dist" },
  // [Agent] Said explicitly because the dashboard created the project with the workers.dev URL off, and the config is what every deploy enforces.
  "workers_dev": true
}
