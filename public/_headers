# [Agent] Cloudflare Pages response headers. Vite fingerprints everything in /assets, so it can be cached forever. Fonts never change under the same name. Data and geography keep their names across pipeline runs, so a day of caching lets a refresh reach visitors by tomorrow.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000

/data/*
  Cache-Control: public, max-age=86400

/geo/*
  Cache-Control: public, max-age=86400
